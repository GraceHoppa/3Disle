{
  "rules": [
    {
      "name": "JavaScript (all chunks)",
      "match": "^assets/.*\\.js$",
      "maxGzipKB": 380
    },
    {
      "name": "CSS",
      "match": "^assets/.*\\.css$",
      "maxGzipKB": 16
    },
    {
      "name": "HTML",
      "match": "^index\\.html$",
      "maxGzipKB": 6
    },
    {
      "name": "The app, without device data",
      "match": "^(?!projects/|models/)",
      "maxGzipKB": 600
    }
  ]
}
