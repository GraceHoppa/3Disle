{
  "name": "3disle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "An engine for explorable 3D teardowns: load models, name their parts, link them into levels, export a page.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "size": "node scripts/check-size.mjs",
    "export": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/export-page.ts",
    "demo": "npm run export -- models/drone/tour.json --single --name fpv-quad --out demo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
