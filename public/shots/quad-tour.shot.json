  "captions": [
    {
      "t0": 0.4,
      "t1": 8.5,
      "scale": "30 cm",
      "title": "5-inch FPV quad",
      "text": "Battery to ESC on two 12 AWG leads, ESC to each motor on three phase wires, the flight controller above the ESC sending four DShot commands down an 8-wire cable.",
      "caption": "Over 100 A flat out, from a pack you hold in one hand."
    },
    {
      "t0": 15.7,
      "t1": 19.4,
      "title": "Props (CW)",
      "text": "5.1-inch tri-blade. Turning, it pushes air down; thrust grows roughly with the square of its speed."
    },
    {
      "t0": 20.3,
      "t1": 24,
      "title": "Props (CCW)",
      "text": "5.1-inch tri-blade. Turning, it pushes air down; thrust grows roughly with the square of its speed."
    },
    {
      "t0": 27.899999999999995,
      "t1": 34.8,
      "scale": "36 mm",
      "title": "SpeedyBee F405 V5 flight controller",
      "text": "A 39 mm square board weighing 8.1 g.",
      "caption": "Sense, decide, command: thousands of times a second."
    },
    {
      "t0": 42,
      "t1": 45.699999999999996,
      "title": "Mounting grommets",
